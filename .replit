[workflows]
runButton = "Start All"

[[workflows.workflow]]
name = "Start All"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && pip install -r requirements.txt && uvicorn main:app --host 0.0.0.0 --port 8000 --reload"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && npm install && npm run dev -- --host 0.0.0.0 --port 5173"

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}/apps/api"
VITE_API_BASE_URL = "http://localhost:8000"
