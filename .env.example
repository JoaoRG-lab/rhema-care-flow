# ================================================
# Rhema Care Flow — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca commite arquivos .env reais.
# ================================================

# Frontend / Supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_anon_do_supabase

# Feature flags opcionais
VITE_APP_ENV=development
VITE_GEMINI_ENABLED=false

# Supabase Edge Functions — configurar no painel do Supabase, não no frontend
# PERPLEXITY_API_KEY=sua_chave_perplexity
# PERPLEXITY_MODEL=sonar-pro
# GEMINI_API_KEY=sua_chave_google_ai_studio

# Observações
# - O frontend usa VITE_SUPABASE_PUBLISHABLE_KEY em src/integrations/supabase/client.ts.
# - A Edge Function ai-assistant usa PERPLEXITY_API_KEY e, opcionalmente, GEMINI_API_KEY.
# - Variáveis sem prefixo VITE_ não devem ser expostas ao navegador.
