# ================================================
# Rhema Care Flow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env real
# ================================================

# Supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica_aqui

# Hugging Face — IA Interna
# Obtenha em: https://huggingface.co/settings/tokens
# Use token com permissão: Inference API (read)
VITE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo HuggingFace (opcional — padrão: HuggingFaceH4/zephyr-7b-beta)
# VITE_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Ambiente
VITE_APP_ENV=development
